[Unit]
Description=Update Trace Marketing Agent from verified main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/share/trace-marketing-server/current/agent-manager.py update
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=true
