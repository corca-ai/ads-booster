# Copy to ~/.config/trace-marketing/agent.env (600). Never commit real secrets.
TRACE_MARKETING_SLACK_ONLY=1
TRACE_MARKETING_PUBLIC_ORIGIN=https://marketing-agent.borca.ai
TRACE_MARKETING_MODEL=REPLACE_WITH_APPROVED_MODEL
TRACE_MARKETING_TENANT=corca-marketing
TRACE_MARKETING_SLACK_BOT_TOKEN=REPLACE_BOT_TOKEN
TRACE_MARKETING_SLACK_CHANNEL_ID=REPLACE_CHANNEL_ID
TRACE_MARKETING_SLACK_BOT_USER_ID=REPLACE_BOT_USER_ID
TRACE_MARKETING_SLACK_ALLOWED_CHANNEL_IDS=REPLACE_CHANNEL_ID
TRACE_MARKETING_SLACK_ALLOW_DM=1
TRACE_MARKETING_SLACK_SIGNING_SECRET=REPLACE_SIGNING_SECRET
TRACE_MARKETING_SLACK_INSTALLATION=/REPLACE_HOME/.config/trace-marketing/slack-installation.json

# Optional existing Cloudflare workflow, separate from Tunnel authentication.
# TRACE_MARKETING_HOSTED_ORIGIN=https://workspace.borca.ai
# TRACE_MARKETING_CONTROL_TOKEN=REPLACE_WORKSPACE_CONTROL_TOKEN

# Optional daily research. Enable after an actual Slack roundtrip.
# TRACE_MARKETING_DAILY_SKILL=research.daily_slack_only
# TRACE_MARKETING_DAILY_RESEARCH_INPUT=/REPLACE_HOME/.config/trace-marketing/daily-research.json
# TRACE_MARKETING_DAILY_AT=08:00
# TRACE_MARKETING_DAILY_TIMEZONE=Asia/Seoul
# TRACE_MARKETING_DAILY_TENANT=corca-marketing
# TRACE_MARKETING_DAILY_PRINCIPAL=scheduled-service

# Only for installations that already have company OAuth and need the web UI:
# Remove TRACE_MARKETING_SLACK_ONLY=1 and configure all the following.
# TRACE_MARKETING_OAUTH_INTROSPECTION_URL=https://IDP/oauth/introspect
# TRACE_MARKETING_OAUTH_CLIENT_ID=INTROSPECTION_CLIENT
# TRACE_MARKETING_OAUTH_CLIENT_SECRET=SECRET
# TRACE_MARKETING_OAUTH_AUDIENCE=trace-marketing-agent
# TRACE_MARKETING_OAUTH_TENANT_CLAIM=workspace_id
# TRACE_MARKETING_LOGIN_AUTHORIZE_URL=https://IDP/oauth/authorize
# TRACE_MARKETING_LOGIN_TOKEN_URL=https://IDP/oauth/token
# TRACE_MARKETING_LOGIN_CLIENT_ID=WEB_CLIENT
# TRACE_MARKETING_LOGIN_CLIENT_SECRET=SECRET
# TRACE_MARKETING_LOGIN_SCOPE="openid profile"
