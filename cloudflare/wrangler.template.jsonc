{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trace-marketing-control",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "workspace.borca.ai", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v1/*", "/health"]
  },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trace-marketing-control",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "trace-marketing-artifacts"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "trace-marketing-tasks"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_AGENT",
        "class_name": "MarketingAccountAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MarketingAccountAgent"]
    }
  ],
  "workflows": [
    {
      "name": "trace-marketing-loop",
      "binding": "MARKETING_WORKFLOW",
      "class_name": "MarketingWorkflow"
    }
  ],
  "vars": {
    "OBSERVATION_MINUTES": "5,10,15,20,25,30",
    "PUBLIC_WORKSPACE_ACCOUNT_ID": "trace_demo_kr",
    "TRACE_DEPLOY_SHA": "__TRACE_DEPLOY_SHA__",
    "THREADS_APP_ID": "__THREADS_APP_ID__",
    "THREADS_GRAPH_API_VERSION": "__THREADS_GRAPH_API_VERSION__",
    "THREADS_PUBLIC_ORIGIN": "__THREADS_PUBLIC_ORIGIN__",
    "THREADS_REDIRECT_URI": "__THREADS_REDIRECT_URI__",
    "WORKSPACE_AI_MODEL": "@cf/openai/gpt-oss-20b",
    "WORKSPACE_AI_MAX_TOKENS": "4096",
    "WORKSPACE_GENERATION_COOLDOWN_SECONDS": "60"
  }
}
