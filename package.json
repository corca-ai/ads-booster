{
  "name": "ads-booster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check . && tsc --noEmit",
    "dev": "nest start --watch",
    "format": "biome format --write .",
    "migration:generate": "bun node_modules/typeorm/cli.js migration:generate src/global/database/migrations/AutoMigration -d src/global/database/data-source.ts",
    "migration:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/global/database/data-source.ts",
    "migration:run": "bun node_modules/typeorm/cli.js migration:run -d src/global/database/data-source.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/typeorm": "^11.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typeorm-ts-node-esm": "^0.3.20",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
